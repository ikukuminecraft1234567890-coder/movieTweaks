<Window x:Class="MovieTweaks.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:MovieTweaks.Controls"
        xmlns:models="clr-namespace:MovieTweaks.Models"
        mc:Ignorable="d"
        Title="movieTweaks - 極限軽量動画エディター"
        Height="800" Width="1200"
        MinHeight="600" MinWidth="900"
        Background="#181818"
        Foreground="#E0E0E0"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Dark Theme Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3E3E42"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#007ACC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Primary Button Style -->
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0E639C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="LosslessButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#107C41"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Dark Theme TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <!-- Dark Theme ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <!-- Compact Preset Button Style -->
        <Style x:Key="PresetButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Background" Value="#2A2A2D"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="MinHeight" Value="18"/>
        </Style>

        <!-- Compact Value Input Box Style -->
        <Style x:Key="ValueInputBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="3,1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Toolbar -->
            <RowDefinition Height="*"/>    <!-- Center (Preview + Property Inspector) -->
            <RowDefinition Height="Auto"/> <!-- Playback Control Bar -->
            <RowDefinition Height="140"/>  <!-- Timeline -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Top Toolbar -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#3E3E42" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand and File Operations -->
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="⚡ movieTweaks" FontSize="15" FontWeight="Bold" Foreground="#4EC9B0" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="📁 動画を開く" Command="{Binding OpenVideoCommand}" ToolTip="動画ファイルを開く (Ctrl+O)"/>
                    <Button Content="💾 保存" Command="{Binding SaveProjectCommand}" ToolTip="プロジェクトを保存 (Ctrl+S)"/>
                    <Button Content="📂 開く" Command="{Binding LoadProjectCommand}" ToolTip="プロジェクトを開く"/>
                    
                    <Separator Width="1" Margin="8,2" Background="#3E3E42"/>

                    <!-- History / Undo Redo -->
                    <Button Content="↩ 戻す" Command="{Binding UndoCommand}" ToolTip="操作を元に戻す (Ctrl+Z)"/>
                    <Button Content="↪ 進む" Command="{Binding RedoCommand}" ToolTip="操作をやり直す (Ctrl+Y)"/>

                    <Separator Width="1" Margin="8,2" Background="#3E3E42"/>

                    <!-- Cut Tools -->
                    <TextBlock Text="カット:" VerticalAlignment="Center" Foreground="#999999" Margin="4,0,4,0"/>
                    <Button Content="[ イン点 (I) ]" Command="{Binding SetInPointCommand}" ToolTip="現在の再生位置を開始点に設定"/>
                    <Button Content="[ アウト点 (O) ]" Command="{Binding SetOutPointCommand}" ToolTip="現在の再生位置を終了点に設定"/>
                    <Button Content="✂ 分割 (S)" Command="{Binding SplitCutCommand}" ToolTip="現在の位置で分割"/>
                    <Button Content="リセット" Command="{Binding ResetCutCommand}" ToolTip="カット範囲を動画全体に戻す"/>

                    <Separator Width="1" Margin="8,2" Background="#3E3E42"/>

                    <!-- Overlay Tools -->
                    <TextBlock Text="追加:" VerticalAlignment="Center" Foreground="#999999" Margin="4,0,4,0"/>
                    <Button Content="T 文字" Command="{Binding AddTextOverlayCommand}" ToolTip="テキストテロップを追加"/>
                    <Button Content="⬛ 四角" Command="{Binding AddShapeOverlayCommand}" ToolTip="四角形を追加">
                        <Button.CommandParameter>
                            <models:ShapeType>Rectangle</models:ShapeType>
                        </Button.CommandParameter>
                    </Button>
                    <Button Content="⚪ 円" Command="{Binding AddShapeOverlayCommand}" ToolTip="円・楕円を追加">
                        <Button.CommandParameter>
                            <models:ShapeType>Ellipse</models:ShapeType>
                        </Button.CommandParameter>
                    </Button>
                    <Button Content="▲ 三角" Command="{Binding AddShapeOverlayCommand}" ToolTip="三角形を追加">
                        <Button.CommandParameter>
                            <models:ShapeType>Triangle</models:ShapeType>
                        </Button.CommandParameter>
                    </Button>
                    <Button Content="★ 星" Command="{Binding AddShapeOverlayCommand}" ToolTip="星を追加">
                        <Button.CommandParameter>
                            <models:ShapeType>Star</models:ShapeType>
                        </Button.CommandParameter>
                    </Button>
                    <Button Content="♥ ハート" Command="{Binding AddShapeOverlayCommand}" ToolTip="ハートを追加">
                        <Button.CommandParameter>
                            <models:ShapeType>Heart</models:ShapeType>
                        </Button.CommandParameter>
                    </Button>
                    <Button Content="💬 吹出" Command="{Binding AddShapeOverlayCommand}" ToolTip="吹き出しざぶとんを追加">
                        <Button.CommandParameter>
                            <models:ShapeType>SpeechBubble</models:ShapeType>
                        </Button.CommandParameter>
                    </Button>
                    <Button Content="➔ 矢印" Command="{Binding AddShapeOverlayCommand}" ToolTip="矢印を追加">
                        <Button.CommandParameter>
                            <models:ShapeType>Arrow</models:ShapeType>
                        </Button.CommandParameter>
                    </Button>
                    <Button Content="🖼 画像" Command="{Binding AddImageOverlayCommand}" ToolTip="画像・スタンプを追加"/>
                </StackPanel>

                <!-- Export Buttons -->
                <StackPanel Orientation="Horizontal" Grid.Column="2">
                    <Button Content="⚡ 無劣化カット出力 (超高速)"
                            Command="{Binding ExportLosslessCommand}"
                            Style="{StaticResource LosslessButtonStyle}"
                            ToolTip="再エンコードなしで数秒で出力します（カット編集のみの時に最適）"/>
                    <Button Content="🎬 合成書き出し (MP4)"
                            Command="{Binding ExportCompositeCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTip="文字・図形・画像を動画に合成して書き出します"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Center Area: Video Preview + Inspector -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- Video Preview Container -->
            <Border Grid.Column="0" Background="#111111" Margin="8" CornerRadius="6" ClipToBounds="True">
                <Grid x:Name="PreviewAreaGrid" SizeChanged="PreviewAreaGrid_SizeChanged">
                    <Grid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="📝 ここにテキストを追加" Command="{Binding AddTextOverlayCommand}"/>
                            <MenuItem Header="⬛ ここに四角形を追加" Command="{Binding AddShapeOverlayCommand}">
                                <MenuItem.CommandParameter>
                                    <models:ShapeType>Rectangle</models:ShapeType>
                                </MenuItem.CommandParameter>
                            </MenuItem>
                            <MenuItem Header="⚪ ここに円を追加" Command="{Binding AddShapeOverlayCommand}">
                                <MenuItem.CommandParameter>
                                    <models:ShapeType>Ellipse</models:ShapeType>
                                </MenuItem.CommandParameter>
                            </MenuItem>
                            <MenuItem Header="▲ ここに三角形を追加" Command="{Binding AddShapeOverlayCommand}">
                                <MenuItem.CommandParameter>
                                    <models:ShapeType>Triangle</models:ShapeType>
                                </MenuItem.CommandParameter>
                            </MenuItem>
                            <MenuItem Header="★ ここに星を追加" Command="{Binding AddShapeOverlayCommand}">
                                <MenuItem.CommandParameter>
                                    <models:ShapeType>Star</models:ShapeType>
                                </MenuItem.CommandParameter>
                            </MenuItem>
                            <MenuItem Header="♥ ここにハートを追加" Command="{Binding AddShapeOverlayCommand}">
                                <MenuItem.CommandParameter>
                                    <models:ShapeType>Heart</models:ShapeType>
                                </MenuItem.CommandParameter>
                            </MenuItem>
                            <MenuItem Header="💬 ここに吹き出しを追加" Command="{Binding AddShapeOverlayCommand}">
                                <MenuItem.CommandParameter>
                                    <models:ShapeType>SpeechBubble</models:ShapeType>
                                </MenuItem.CommandParameter>
                            </MenuItem>
                            <MenuItem Header="➔ ここに矢印を追加" Command="{Binding AddShapeOverlayCommand}">
                                <MenuItem.CommandParameter>
                                    <models:ShapeType>Arrow</models:ShapeType>
                                </MenuItem.CommandParameter>
                            </MenuItem>
                            <MenuItem Header="🖼 ここに画像を配置..." Command="{Binding AddImageOverlayCommand}"/>
                            <Separator/>
                            <MenuItem Header="✂ ここで分割 (S)" Command="{Binding SplitCutCommand}"/>
                            <MenuItem Header="📍 ここをイン点に設定 (I)" Command="{Binding SetInPointCommand}"/>
                            <MenuItem Header="📍 ここをアウト点に設定 (O)" Command="{Binding SetOutPointCommand}"/>
                            <Separator/>
                            <MenuItem Header="📋 選択アイテムを複製" Command="{Binding DuplicateSelectedOverlayCommand}"
                                      Visibility="{Binding HasSelectedOverlay, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}"/>
                            <MenuItem Header="🗑 選択アイテムを削除 (Delete)" Command="{Binding DeleteSelectedCommand}"
                                      Visibility="{Binding HasSelection, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}"/>
                        </ContextMenu>
                    </Grid.ContextMenu>

                    <!-- Placeholder when no video -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding Project.SourceVideo, Converter={x:Static controls:NullToVisibilityConverter.Instance}}">
                        <TextBlock Text="🎬" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="動画ファイルをここにドラッグ＆ドロップ" FontSize="16" FontWeight="SemiBold" Foreground="#CCCCCC" HorizontalAlignment="Center"/>
                        <TextBlock Text="または「動画を開く」ボタンをクリック" FontSize="12" Foreground="#888888" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Media Element (Native Video Player) -->
                    <MediaElement x:Name="Player"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Stop"
                                  ScrubbingEnabled="True"
                                  MediaOpened="Player_MediaOpened"
                                  MediaEnded="Player_MediaEnded"
                                  MediaFailed="Player_MediaFailed"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>

                    <!-- Overlay Interactive Canvas (Aligned with Video Frame) -->
                    <controls:OverlayCanvas x:Name="OverlayCanvasControl"
                                            Overlays="{Binding Project.Overlays}"
                                            CurrentTime="{Binding CurrentTimeSeconds}"
                                            SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                            VideoWidth="{Binding Project.SourceVideo.Width}"
                                            VideoHeight="{Binding Project.SourceVideo.Height}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Right Inspector Panel -->
            <Border Grid.Column="1" Background="#202020" BorderBrush="#333333" BorderThickness="1,0,0,0" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="プロパティ" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>

                        <!-- If No Selection -->
                        <TextBlock Text="タイムライン上のクリップや動画画面をクリックすると、プロパティを編集できます。"
                                   Foreground="#777777" TextWrapping="Wrap"
                                   Visibility="{Binding HasSelection, Converter={x:Static controls:InverseBooleanToVisibilityConverter.Instance}}"/>

                        <!-- VIDEO CLIP PROPERTY PANEL (YMM4-style) -->
                        <StackPanel Visibility="{Binding IsVideoSelected, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                            <Border Background="#107C41" CornerRadius="4" Padding="6,3" Margin="0,0,0,10" HorizontalAlignment="Left">
                                <TextBlock Text="🎬 動画クリップ" FontWeight="Bold" Foreground="White" FontSize="12"/>
                            </Border>

                            <TextBlock Text="ファイル名" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock Text="{Binding SelectedVideoClip.FileName}" Foreground="#F1F1F1" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

                            <TextBlock Text="{Binding SelectedVideoClip.FilePath}" Foreground="#777777" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>

                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="解像度" Foreground="#AAAAAA" FontSize="11"/>
                                    <TextBlock Foreground="#CCCCCC">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} x {1}">
                                                <Binding Path="SelectedVideoClip.Width"/>
                                                <Binding Path="SelectedVideoClip.Height"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="フレームレート" Foreground="#AAAAAA" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedVideoClip.Fps, StringFormat='{}{0:F1} fps'}" Foreground="#CCCCCC"/>
                                </StackPanel>
                            </Grid>

                            <Separator Margin="0,10" Background="#333333"/>

                            <!-- Volume Control (% Notation, allows > 100%) -->
                            <Grid Margin="0,4,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="音量 (最大2000%)" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ValueInputBoxStyle}"
                                         Text="{Binding CurrentVolumePercent, Converter={x:Static controls:PercentConverter.Instance}, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <Slider Minimum="0" Maximum="500" Value="{Binding CurrentVolumePercent}" SmallChange="5" LargeChange="25"/>
                            <WrapPanel Margin="0,2,0,6">
                                <Button Content="0%" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetVolumePresetCommand}" CommandParameter="0"/>
                                <Button Content="50%" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetVolumePresetCommand}" CommandParameter="50"/>
                                <Button Content="100%" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetVolumePresetCommand}" CommandParameter="100"/>
                                <Button Content="150%" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetVolumePresetCommand}" CommandParameter="150"/>
                                <Button Content="200%" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetVolumePresetCommand}" CommandParameter="200"/>
                                <Button Content="300%" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetVolumePresetCommand}" CommandParameter="300"/>
                                <Button Content="500%" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetVolumePresetCommand}" CommandParameter="500"/>
                                <Button Content="1000%" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetVolumePresetCommand}" CommandParameter="1000"/>
                            </WrapPanel>

                            <!-- Playback Speed Control (% Notation, allows > 100%, up to 10000% / 100x) -->
                            <Grid Margin="0,6,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="再生速度 (50倍=5000%対応)" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ValueInputBoxStyle}"
                                         Text="{Binding CurrentPlaybackSpeedPercent, Converter={x:Static controls:PercentConverter.Instance}, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <Slider Minimum="25" Maximum="1000" Value="{Binding CurrentPlaybackSpeedPercent}" SmallChange="5" LargeChange="50"/>
                            <WrapPanel Margin="0,2,0,6">
                                <Button Content="50%" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetSpeedPresetCommand}" CommandParameter="50"/>
                                <Button Content="100%" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetSpeedPresetCommand}" CommandParameter="100"/>
                                <Button Content="150%" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetSpeedPresetCommand}" CommandParameter="150"/>
                                <Button Content="200%" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetSpeedPresetCommand}" CommandParameter="200"/>
                                <Button Content="500%" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetSpeedPresetCommand}" CommandParameter="500"/>
                                <Button Content="1000%" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetSpeedPresetCommand}" CommandParameter="1000"/>
                                <Button Content="2000%" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetSpeedPresetCommand}" CommandParameter="2000"/>
                                <Button Content="5000% (50倍)" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetSpeedPresetCommand}" CommandParameter="5000" FontWeight="Bold" Foreground="#4EC9B0"/>
                            </WrapPanel>

                            <Separator Margin="0,10" Background="#333333"/>

                            <!-- Cut/Trim info -->
                            <TextBlock Text="動画クリップの配置・カット" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                            <TextBlock Text="💡 タイムライン上で中央ドラッグして移動、端ドラッグで長さを調整できます" Foreground="#888888" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <Grid Margin="0,4,0,0" Visibility="{Binding IsCutRangeSelected, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="タイムライン開始秒" Foreground="#AAAAAA" FontSize="11"/>
                                    <TextBox Text="{Binding SelectedCutRange.StartSeconds, StringFormat='{}{0:F2}', UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Text="タイムライン終了秒" Foreground="#AAAAAA" FontSize="11"/>
                                    <TextBox Text="{Binding SelectedCutRange.EndSeconds, StringFormat='{}{0:F2}', UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,6,0,0" Visibility="{Binding IsCutRangeSelected, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="元動画の開始位置(秒)" Foreground="#AAAAAA" FontSize="11"/>
                                    <TextBox Text="{Binding SelectedCutRange.SourceStartSeconds, StringFormat='{}{0:F2}', UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Text="クリップ長さ" Foreground="#AAAAAA" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedCutRange.Duration, StringFormat='{}{0:F2}s'}" Foreground="#4CAF50" FontWeight="Bold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="[I] ここをイン点" Command="{Binding SetInPointCommand}" FontSize="11" Padding="6,3"/>
                                <Button Content="[O] ここをアウト点" Command="{Binding SetOutPointCommand}" FontSize="11" Padding="6,3" Margin="4,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="✂ ここで分割 (S)" Command="{Binding SplitCutCommand}" FontSize="11" Padding="6,3"/>
                                <Button Content="リセット" Command="{Binding ResetCutCommand}" FontSize="11" Padding="6,3" Margin="4,0,0,0"/>
                            </StackPanel>

                            <Button Content="このカット区間を削除" Command="{Binding DeleteSelectedCommand}"
                                    Visibility="{Binding IsCutRangeSelected, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}"
                                    Background="#782020" Margin="0,10,0,0" FontSize="11"/>
                        </StackPanel>

                        <!-- OVERLAY ITEM PROPERTY PANEL -->
                        <StackPanel Visibility="{Binding HasSelectedOverlay, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                            <!-- Name & Timing -->
                            <TextBlock Text="アイテム名" Foreground="#AAAAAA" FontSize="11" Margin="0,4,0,2"/>
                            <TextBox Text="{Binding SelectedOverlay.Name, UpdateSourceTrigger=PropertyChanged}"/>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="開始秒" Foreground="#AAAAAA" FontSize="11"/>
                                    <TextBox Text="{Binding SelectedOverlay.StartTime, StringFormat='{}{0:F2}', UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Text="終了秒" Foreground="#AAAAAA" FontSize="11"/>
                                    <TextBox Text="{Binding SelectedOverlay.EndTime, StringFormat='{}{0:F2}', UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Opacity (%) -->
                            <Grid Margin="0,8,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="不透明度" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ValueInputBoxStyle}"
                                         Text="{Binding CurrentOpacityPercent, Converter={x:Static controls:PercentConverter.Instance}, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <Slider Minimum="0" Maximum="100" Value="{Binding CurrentOpacityPercent}" SmallChange="5" LargeChange="10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                                <Button Content="0%" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetOpacityPresetCommand}" CommandParameter="0"/>
                                <Button Content="25%" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetOpacityPresetCommand}" CommandParameter="25"/>
                                <Button Content="50%" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetOpacityPresetCommand}" CommandParameter="50"/>
                                <Button Content="75%" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetOpacityPresetCommand}" CommandParameter="75"/>
                                <Button Content="100%" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetOpacityPresetCommand}" CommandParameter="100"/>
                            </StackPanel>

                            <!-- Scale (%) -->
                            <Grid Margin="0,6,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="拡大率 (サイズ %)" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ValueInputBoxStyle}"
                                         Text="{Binding CurrentScalePercent, Converter={x:Static controls:PercentConverter.Instance}, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <Slider Minimum="20" Maximum="500" Value="{Binding CurrentScalePercent}" SmallChange="5" LargeChange="20"/>
                            <WrapPanel Margin="0,2,0,6">
                                <Button Content="50%" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetScalePresetCommand}" CommandParameter="50"/>
                                <Button Content="75%" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetScalePresetCommand}" CommandParameter="75"/>
                                <Button Content="100%" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetScalePresetCommand}" CommandParameter="100"/>
                                <Button Content="150%" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetScalePresetCommand}" CommandParameter="150"/>
                                <Button Content="200%" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetScalePresetCommand}" CommandParameter="200"/>
                                <Button Content="300%" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetScalePresetCommand}" CommandParameter="300"/>
                                <Button Content="500%" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetScalePresetCommand}" CommandParameter="500"/>
                                <Button Content="1000%" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetScalePresetCommand}" CommandParameter="1000"/>
                            </WrapPanel>

                            <!-- Rotation (Degree) -->
                            <Grid Margin="0,6,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="回転角度 (°)" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ValueInputBoxStyle}"
                                         Text="{Binding CurrentRotationDegrees, Converter={x:Static controls:UnitConverter.Instance}, ConverterParameter='°', UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <Slider Minimum="0" Maximum="360" Value="{Binding CurrentRotationDegrees}" SmallChange="1" LargeChange="15"/>
                            <WrapPanel Margin="0,2,0,6">
                                <Button Content="0°" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetRotationPresetCommand}" CommandParameter="0"/>
                                <Button Content="45°" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetRotationPresetCommand}" CommandParameter="45"/>
                                <Button Content="90°" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetRotationPresetCommand}" CommandParameter="90"/>
                                <Button Content="180°" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetRotationPresetCommand}" CommandParameter="180"/>
                                <Button Content="270°" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetRotationPresetCommand}" CommandParameter="270"/>
                            </WrapPanel>

                            <Separator Margin="0,12" Background="#333333"/>

                            <!-- TEXT SPECIFIC CONTROLS -->
                            <StackPanel Visibility="{Binding IsTextSelected, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                                <TextBlock Text="文字内容" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedOverlay.Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="50" TextWrapping="Wrap"/>

                                <!-- Font Family Selection with Preview -->
                                <TextBlock Text="フォント (書体一覧)" Foreground="#AAAAAA" FontSize="11" Margin="0,8,0,2"/>
                                <ComboBox ItemsSource="{Binding AvailableFontFamilies}"
                                          SelectedItem="{Binding SelectedTextOverlay.FontFamily, UpdateSourceTrigger=PropertyChanged}"
                                          MaxDropDownHeight="320">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="13" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Grid Margin="0,8,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="フォントサイズ" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource ValueInputBoxStyle}"
                                             Text="{Binding SelectedTextOverlay.FontSize, Converter={x:Static controls:UnitConverter.Instance}, ConverterParameter='pt', UpdateSourceTrigger=LostFocus}"/>
                                </Grid>
                                <Slider Minimum="12" Maximum="140" Value="{Binding SelectedTextOverlay.FontSize}"/>

                                <!-- Alignment & Styles -->
                                <Grid Margin="0,8,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="文字揃え / スタイル" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <CheckBox Content="太字" IsChecked="{Binding SelectedTextOverlay.IsBold}" Margin="0,0,8,0" Foreground="#E0E0E0" FontSize="11"/>
                                        <CheckBox Content="斜体" IsChecked="{Binding SelectedTextOverlay.IsItalic}" Foreground="#E0E0E0" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                                    <Button Content="左揃え" Style="{StaticResource PresetButtonStyle}" Width="60" Command="{Binding SetTextAlignmentCommand}" CommandParameter="Left"/>
                                    <Button Content="中央揃え" Style="{StaticResource PresetButtonStyle}" Width="60" Command="{Binding SetTextAlignmentCommand}" CommandParameter="Center"/>
                                    <Button Content="右揃え" Style="{StaticResource PresetButtonStyle}" Width="60" Command="{Binding SetTextAlignmentCommand}" CommandParameter="Right"/>
                                </StackPanel>

                                <!-- YMM4-style Telop Color Presets -->
                                <TextBlock Text="定番テロップ配色 (YMM4風プリセット)" Foreground="#AAAAAA" FontSize="11" Margin="0,6,0,2"/>
                                <WrapPanel Margin="0,2,0,6">
                                    <Button Style="{StaticResource PresetButtonStyle}" Command="{Binding ApplyTextPresetColorCommand}" CommandParameter="WhiteBlack" ToolTip="白文字 + 黒縁取り">
                                        <TextBlock Text="白/黒" Foreground="White" Background="Black" Padding="4,1"/>
                                    </Button>
                                    <Button Style="{StaticResource PresetButtonStyle}" Command="{Binding ApplyTextPresetColorCommand}" CommandParameter="YellowBlack" ToolTip="黄色文字 + 黒縁取り">
                                        <TextBlock Text="黄/黒" Foreground="Yellow" Background="Black" Padding="4,1"/>
                                    </Button>
                                    <Button Style="{StaticResource PresetButtonStyle}" Command="{Binding ApplyTextPresetColorCommand}" CommandParameter="RedWhite" ToolTip="赤文字 + 白縁取り">
                                        <TextBlock Text="赤/白" Foreground="Red" Background="White" Padding="4,1"/>
                                    </Button>
                                    <Button Style="{StaticResource PresetButtonStyle}" Command="{Binding ApplyTextPresetColorCommand}" CommandParameter="CyanBlack" ToolTip="水色文字 + 黒縁取り">
                                        <TextBlock Text="水/黒" Foreground="Cyan" Background="Black" Padding="4,1"/>
                                    </Button>
                                    <Button Style="{StaticResource PresetButtonStyle}" Command="{Binding ApplyTextPresetColorCommand}" CommandParameter="GreenBlack" ToolTip="緑文字 + 黒縁取り">
                                        <TextBlock Text="緑/黒" Foreground="#00FF66" Background="Black" Padding="4,1"/>
                                    </Button>
                                    <Button Style="{StaticResource PresetButtonStyle}" Command="{Binding ApplyTextPresetColorCommand}" CommandParameter="BlackWhite" ToolTip="黒文字 + 白縁取り">
                                        <TextBlock Text="黒/白" Foreground="Black" Background="White" Padding="4,1"/>
                                    </Button>
                                </WrapPanel>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="文字色 (HEX)" Foreground="#AAAAAA" FontSize="11"/>
                                        <TextBox Text="{Binding SelectedOverlay.TextColor, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="縁取り色 (HEX)" Foreground="#AAAAAA" FontSize="11"/>
                                        <TextBox Text="{Binding SelectedOverlay.OutlineColor, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,6,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="縁取りの太さ" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource ValueInputBoxStyle}"
                                             Text="{Binding SelectedTextOverlay.OutlineThickness, Converter={x:Static controls:UnitConverter.Instance}, ConverterParameter='px', UpdateSourceTrigger=LostFocus}"/>
                                </Grid>
                                <Slider Minimum="0" Maximum="20" Value="{Binding SelectedTextOverlay.OutlineThickness}"/>

                                <TextBlock Text="背景色 (HEX / Transparent)" Foreground="#AAAAAA" FontSize="11" Margin="0,6,0,2"/>
                                <TextBox Text="{Binding SelectedOverlay.BackgroundColor, UpdateSourceTrigger=PropertyChanged}"/>

                                <Grid Margin="0,6,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="背景の角丸" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource ValueInputBoxStyle}"
                                             Text="{Binding SelectedTextOverlay.BackgroundCornerRadius, Converter={x:Static controls:UnitConverter.Instance}, ConverterParameter='px', UpdateSourceTrigger=LostFocus}"/>
                                </Grid>
                                <Slider Minimum="0" Maximum="40" Value="{Binding SelectedTextOverlay.BackgroundCornerRadius}"/>
                            </StackPanel>

                            <!-- SHAPE SPECIFIC CONTROLS (YMM4-style high freedom) -->
                            <StackPanel Visibility="{Binding IsShapeSelected, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                                <!-- Shape Type Switcher -->
                                <TextBlock Text="図形の種類" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding AvailableShapeTypes}"
                                          SelectedItem="{Binding SelectedShapeOverlay.ShapeType, UpdateSourceTrigger=PropertyChanged}"
                                          MaxDropDownHeight="300">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={x:Static controls:ShapeTypeConverter.Instance}}" FontSize="12"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Stroke Style (Solid / Dash / Dot) -->
                                <TextBlock Text="線の種類 (破線・点線)" Foreground="#AAAAAA" FontSize="11" Margin="0,8,0,2"/>
                                <ComboBox ItemsSource="{Binding AvailableStrokeStyles}"
                                          SelectedItem="{Binding SelectedShapeOverlay.StrokeStyle, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={x:Static controls:StrokeStyleConverter.Instance}}" FontSize="12"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Fill Color & Quick Palette -->
                                <TextBlock Text="塗りつぶし色 (HEX / Transparent)" Foreground="#AAAAAA" FontSize="11" Margin="0,8,0,2"/>
                                <TextBox Text="{Binding SelectedOverlay.FillColor, UpdateSourceTrigger=PropertyChanged}"/>
                                <WrapPanel Margin="0,2,0,4">
                                    <Button Content="透明" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetShapeFillPresetCommand}" CommandParameter="Transparent"/>
                                    <Button Content="白" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetShapeFillPresetCommand}" CommandParameter="#FFFFFF"/>
                                    <Button Content="黒" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetShapeFillPresetCommand}" CommandParameter="#000000"/>
                                    <Button Content="赤" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetShapeFillPresetCommand}" CommandParameter="#FF0000"/>
                                    <Button Content="黄" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetShapeFillPresetCommand}" CommandParameter="#FFFF00"/>
                                    <Button Content="緑" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetShapeFillPresetCommand}" CommandParameter="#00CC44"/>
                                    <Button Content="水色" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetShapeFillPresetCommand}" CommandParameter="#00CCFF"/>
                                    <Button Content="青" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetShapeFillPresetCommand}" CommandParameter="#0066FF"/>
                                    <Button Content="橙" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetShapeFillPresetCommand}" CommandParameter="#FF8800"/>
                                    <Button Content="半黒" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetShapeFillPresetCommand}" CommandParameter="#80000000" ToolTip="半透明黒（ざぶとん用）"/>
                                </WrapPanel>

                                <!-- Stroke Color & Quick Palette -->
                                <TextBlock Text="枠線色 (HEX / Transparent)" Foreground="#AAAAAA" FontSize="11" Margin="0,6,0,2"/>
                                <TextBox Text="{Binding SelectedOverlay.StrokeColor, UpdateSourceTrigger=PropertyChanged}"/>
                                <WrapPanel Margin="0,2,0,4">
                                    <Button Content="無枠" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetShapeStrokePresetCommand}" CommandParameter="Transparent"/>
                                    <Button Content="白" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetShapeStrokePresetCommand}" CommandParameter="#FFFFFF"/>
                                    <Button Content="黒" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetShapeStrokePresetCommand}" CommandParameter="#000000"/>
                                    <Button Content="赤" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetShapeStrokePresetCommand}" CommandParameter="#FF0000"/>
                                    <Button Content="黄" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetShapeStrokePresetCommand}" CommandParameter="#FFFF00"/>
                                    <Button Content="緑" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetShapeStrokePresetCommand}" CommandParameter="#00CC44"/>
                                    <Button Content="水色" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetShapeStrokePresetCommand}" CommandParameter="#00CCFF"/>
                                    <Button Content="青" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetShapeStrokePresetCommand}" CommandParameter="#0066FF"/>
                                    <Button Content="橙" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetShapeStrokePresetCommand}" CommandParameter="#FF8800"/>
                                </WrapPanel>

                                <Grid Margin="0,6,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="線の太さ" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource ValueInputBoxStyle}"
                                             Text="{Binding SelectedShapeOverlay.StrokeThickness, Converter={x:Static controls:UnitConverter.Instance}, ConverterParameter='px', UpdateSourceTrigger=LostFocus}"/>
                                </Grid>
                                <Slider Minimum="0" Maximum="40" Value="{Binding SelectedShapeOverlay.StrokeThickness}"/>

                                <Grid Margin="0,6,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="角丸 (四角形・吹出)" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource ValueInputBoxStyle}"
                                             Text="{Binding SelectedShapeOverlay.CornerRadius, Converter={x:Static controls:UnitConverter.Instance}, ConverterParameter='px', UpdateSourceTrigger=LostFocus}"/>
                                </Grid>
                                <Slider Minimum="0" Maximum="60" Value="{Binding SelectedShapeOverlay.CornerRadius}"/>
                            </StackPanel>

                            <!-- IMAGE SPECIFIC CONTROLS -->
                            <StackPanel Visibility="{Binding IsImageSelected, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                                <TextBlock Text="画像パス" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedOverlay.ImagePath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
                                <CheckBox Content="アスペクト比を維持" IsChecked="{Binding SelectedOverlay.KeepAspectRatio}" Margin="0,8,0,0" Foreground="#E0E0E0"/>
                            </StackPanel>

                            <Separator Margin="0,14" Background="#333333"/>

                            <!-- Item Operations -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="複製" Command="{Binding DuplicateSelectedOverlayCommand}" Width="70"/>
                                <Button Content="削除" Command="{Binding DeleteSelectedCommand}" Background="#782020" Width="70" Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 3. Playback Control Bar -->
        <Border Grid.Row="2" Background="#202020" BorderBrush="#333333" BorderThickness="0,1,0,1" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Frame Step and Play Controls -->
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Button Content="◀◀" Command="{Binding StepBackwardCommand}" ToolTip="1フレーム戻る (Left / J)" Width="40"/>
                    <Button Content="{Binding PlayPauseButtonText}" Command="{Binding PlayPauseCommand}" ToolTip="再生 / 一時停止 (Space / K)" Width="80" FontWeight="Bold"/>
                    <Button Content="▶▶" Command="{Binding StepForwardCommand}" ToolTip="1フレーム進む (Right / L)" Width="40"/>
                </StackPanel>

                <!-- Center: Time Display -->
                <TextBlock Grid.Column="1" Text="{Binding CurrentTimeDisplay}"
                           FontSize="15" FontWeight="SemiBold" FontFamily="Consolas"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#4EC9B0"/>

                <!-- Right: Zoom & Shortcuts Hint -->
                <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="ズーム:" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Slider Minimum="20" Maximum="500" Width="80" Value="{Binding TimelineZoomPercent}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Style="{StaticResource ValueInputBoxStyle}" Width="48"
                             Text="{Binding TimelineZoomPercent, Converter={x:Static controls:PercentConverter.Instance}, UpdateSourceTrigger=LostFocus}" Margin="0,0,12,0"/>
                    <TextBlock Text="[Space] 再生 | [Ctrl+Z] 戻す | [S] 分割 | [I/O] イン/アウト | [Del] 削除"
                               FontSize="11" Foreground="#777777" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. Timeline -->
        <controls:TimelineControl Grid.Row="3"
                                  Duration="{Binding TotalDurationSeconds}"
                                  CurrentTime="{Binding CurrentTimeSeconds, Mode=TwoWay}"
                                  CutRanges="{Binding Project.CutRanges}"
                                  Overlays="{Binding Project.Overlays}"
                                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                  Zoom="{Binding TimelineZoom, Mode=TwoWay}"/>

        <!-- 5. Status Bar & Progress -->
        <Border Grid.Row="4" Background="#007ACC" Padding="8,4" TextBlock.Foreground="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            Visibility="{Binding IsExporting, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                    <ProgressBar Width="140" Height="14" Value="{Binding ExportProgress}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ExportProgress, StringFormat='{}{0:F0}%'}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="キャンセル" Command="{Binding CancelExportCommand}" Padding="6,2" FontSize="11" Background="#A00000"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
