<UserControl x:Class="MovieTweaks.Controls.TimelineControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="140" d:DesignWidth="800"
             Background="#1E1E1E"
             PreviewMouseRightButtonDown="TimelineControl_PreviewMouseRightButtonDown">

    <UserControl.Resources>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
    </UserControl.Resources>

    <UserControl.ContextMenu>
        <ContextMenu x:Name="TimelineContextMenu">
            <MenuItem Header="✂ ここで分割 (S)" Click="MenuSplit_Click"/>
            <MenuItem Header="📍 ここをイン点 (開始位置) に設定 (I)" Click="MenuSetIn_Click"/>
            <MenuItem Header="📍 ここをアウト点 (終了位置) に設定 (O)" Click="MenuSetOut_Click"/>
            <Separator/>
            <MenuItem Header="📝 ここにテキストを追加" Click="MenuAddText_Click"/>
            <MenuItem Header="⬛ ここに四角形を追加" Click="MenuAddRect_Click"/>
            <MenuItem Header="➔ ここに矢印を追加" Click="MenuAddArrow_Click"/>
            <MenuItem Header="🖼 ここに画像を配置..." Click="MenuAddImage_Click"/>
            <Separator/>
            <MenuItem Header="🗑 選択中アイテムを削除 (Delete)" Click="MenuDelete_Click"/>
            <MenuItem Header="🔄 カット範囲をリセット" Click="MenuResetCut_Click"/>
        </ContextMenu>
    </UserControl.ContextMenu>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/> <!-- Ruler -->
            <RowDefinition Height="36"/> <!-- Video / Cut Track -->
            <RowDefinition Height="*"/>  <!-- Overlay Items Track -->
        </Grid.RowDefinitions>

        <!-- Ruler Area -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#3E3E42" BorderThickness="0,0,0,1">
            <Canvas x:Name="RulerCanvas" ClipToBounds="True" Background="Transparent"
                    MouseDown="Ruler_MouseDown" MouseMove="Ruler_MouseMove" MouseUp="Ruler_MouseUp"/>
        </Border>

        <!-- Video & Cut Track -->
        <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="#2D2D30" BorderThickness="0,0,0,1">
            <Canvas x:Name="VideoTrackCanvas" ClipToBounds="True" Background="Transparent"
                    MouseDown="Track_MouseDown"
                    MouseMove="VideoTrack_MouseMove"
                    MouseUp="VideoTrack_MouseUp"/>
        </Border>

        <!-- Overlays Track -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Canvas x:Name="OverlayTrackCanvas" ClipToBounds="True" Background="#181818" Height="60"
                    MouseDown="OverlayTrack_MouseDown"
                    MouseMove="OverlayTrack_MouseMove"
                    MouseUp="OverlayTrack_MouseUp"/>
        </ScrollViewer>

        <!-- Playhead (Overlayed on top of all rows) -->
        <Canvas x:Name="PlayheadCanvas" Grid.RowSpan="3" IsHitTestVisible="False" ClipToBounds="True">
            <Line x:Name="PlayheadLine" Y1="0" Y2="1000" Stroke="#E81123" StrokeThickness="2"/>
            <Polygon x:Name="PlayheadHead" Fill="#E81123" Points="0,0 12,0 6,10"/>
        </Canvas>
    </Grid>
</UserControl>
